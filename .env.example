# Resend API Key for sending emails
# Get your key at https://resend.com/
RESEND_API_KEY=

# Contact form email configuration
# FROM must be a verified domain in Resend (e.g., contact@zyphr.app)
CONTACT_FROM_EMAIL="Zyphr Contact <contact@zyphr.app>"
# TO is where you want to receive the messages (e.g., zyphrapp@proton.me)
CONTACT_TO_EMAIL=zyphrapp@proton.me
